$ mcpgraph hook claude-code --print-config --bin /usr/local/bin/mcpgraph
{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "args": [
              "hook",
              "claude-code"
            ],
            "command": "/usr/local/bin/mcpgraph",
            "onFailure": "block",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|Read|Edit|Write|mcp__.*"
      }
    ]
  }
}

$ mcpgraph hook codex < testdata/hooks/codex/*.json   # ask becomes deny with an explanation
$ mcpgraph hook codex < testdata/hooks/codex/bash-drop-table.json
tool_name: Bash   input: psql -c "DROP TABLE users"
stdout:
  {"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"mcpgraph blocked this by rule block-destructive-sql: Destructive SQL is blocked: DROP TABLE, DROP DATABASE/SCHEMA, TRUNCATE and DELETE without a limiting WHERE clause (WHERE 1=1 does not count)."}}
stderr:
exit code: 0

$ mcpgraph hook codex < testdata/hooks/codex/bash-ls.json

$ mcpgraph collector + two laptops with mcpgraph sink
# started in the background: mcpgraph collector --listen 127.0.0.1:7600 --data /srv/mcpgraph
$ curl -s http://127.0.0.1:7600/healthz
{"status":"ok"}


# laptop A: switch the sink on, then ship the decisions it already has
$ mcpgraph sink set http://127.0.0.1:7600 --host laptop-a
sink on: shipping to http://127.0.0.1:7600 as "laptop-a"
$ mcpgraph sink status
sink: on
url: http://127.0.0.1:7600
host: laptop-a
token: (none)
not shipped yet: 12
$ mcpgraph sink flush
flushed; not shipped yet: 0

# laptop B: every hook decision is shipped as it happens
$ mcpgraph sink set http://127.0.0.1:7600 --host laptop-b
sink on: shipping to http://127.0.0.1:7600 as "laptop-b"
$ mcpgraph hook claude-code < testdata/hooks/claude-code/bash-drop-table.json
$ mcpgraph hook claude-code < testdata/hooks/claude-code/bash-ls.json
$ mcpgraph sink status
sink: on
url: http://127.0.0.1:7600
host: laptop-b
token: (none)
not shipped yet: 0

# the central view
$ curl -s http://127.0.0.1:7600/v1/hosts | python3 -m json.tool
[
    {
        "host": "laptop-a",
        "last_seen": "2026-10-18T08:12:54.115788983Z",
        "events": 12,
        "verdicts": {
            "allow": 3,
            "ask": 2,
            "deny": 7
        }
    },
    {
        "host": "laptop-b",
        "last_seen": "2026-10-18T08:12:54.125839336Z",
        "events": 2,
        "verdicts": {
            "allow": 1,
            "deny": 1
        }
    }
]

